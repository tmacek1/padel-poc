// Prisma schema for Padel PoC
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth.js required models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Application models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isAdmin       Boolean   @default(false)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Player profile
  profileCompleted   Boolean  @default(false) // true nakon sto popuni profil
  gender             String?  // male, female
  dominantHand       String?  // left, right
  preferredCourtSide String?  // left, right

  // Relations
  accounts         Account[]
  sessions         Session[]
  club             Club?          @relation(fields: [clubId], references: [id])
  clubId           String?
  locations        UserLocation[]
  createdMatches   Match[]        @relation("MatchCreator")
  matchPlayers     MatchPlayer[]
  leagueTeams      LeagueTeamPlayer[]
  sentMessages     Message[]      @relation("MessageSender")
  receivedMessages Message[]      @relation("MessageReceiver")
  standings        SeasonStanding[] @relation("PlayerStanding")
  setPlayers       SetPlayer[]
  createdLeagues   League[]       @relation("LeagueCreator")
}

model Club {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  createdAt DateTime @default(now())

  members User[]
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  createdAt DateTime @default(now())

  userLocations   UserLocation[]
  matches         Match[]
  leagueMatchups  LeagueMatchup[]
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  isPrimary  Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

// ============================================
// Match models
// ============================================

model Match {
  id          String      @id @default(cuid())
  creatorId   String
  locationId  String?
  scheduledAt DateTime?
  playedAt    DateTime?
  status      String      @default("scheduled") // scheduled, in_progress, completed, cancelled
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Liga poveznica (opcionalno)
  leagueId         String?
  league           League?     @relation(fields: [leagueId], references: [id])

  // Pravila meca
  scoringType      String   @default("golden_point") // golden_point, classic (deuce/advantage)
  setsToWin        Int      @default(2) // broj setova za pobjedu (standardno 2)
  durationMinutes  Int      @default(90) // trajanje meča u minutama (60-120 za regular, 90 za liga)

  // Bodovanje - koji tim je izgubio u tiebreaku 3. seta (dobiva 1 bod umjesto 0)
  tiebreakLossTeam Int?     // 1 ili 2, null ako nije tiebreak poraz

  creator  User          @relation("MatchCreator", fields: [creatorId], references: [id])
  location Location?     @relation(fields: [locationId], references: [id])
  players  MatchPlayer[]
  sets     MatchSet[]
  matchups LeagueMatchup[]
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  userId   String
  team     Int    // 1 or 2 (padel is 2v2)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model MatchSet {
  id          String @id @default(cuid())
  matchId     String
  setNumber   Int
  team1Score  Int    @default(0)
  team2Score  Int    @default(0)
  team1Tiebreak Int? // ako je tiebreak u setu
  team2Tiebreak Int?

  match           Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerPositions SetPlayerPosition[]
  setPlayers      SetPlayer[]

  @@unique([matchId, setNumber])
}

// Pozicija igrača u setu (lijevo/desno)
model SetPlayerPosition {
  id          String   @id @default(cuid())
  matchSetId  String
  userId      String
  courtSide   String   // "left" or "right"

  matchSet    MatchSet @relation(fields: [matchSetId], references: [id], onDelete: Cascade)

  @@unique([matchSetId, userId])
}

// Igrači u setu (za classic match gdje se mogu mijenjati parovi po setovima)
model SetPlayer {
  id          String   @id @default(cuid())
  matchSetId  String
  userId      String
  team        Int      // 1 or 2

  matchSet    MatchSet @relation(fields: [matchSetId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchSetId, userId])
}

// ============================================
// Season & League models
// ============================================

// Sezona - trajanje 2-3 mjeseca
model Season {
  id                String   @id @default(cuid())
  name              String   // "Sezona 1 2024", "Proljece 2024"
  startDate         DateTime
  endDate           DateTime
  status            String   @default("upcoming") // upcoming, active, completed
  minMatches        Int      @default(8)  // minimum meceva za rangiranje
  promotionPercent  Int      @default(25) // top 25% napreduje
  relegationPercent Int      @default(25) // bottom 25% ispada

  // Bodovni sustav
  pointsForWin         Int @default(3)
  pointsForTiebreakLoss Int @default(1) // poraz u tiebreaku 3. seta
  pointsForLoss        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leagues   League[]
  standings SeasonStanding[]
}

// Liga s tier sustavom
model League {
  id          String   @id @default(cuid())
  name        String
  description String?

  // Tier: bronze, silver, gold, platinum, diamond
  tier        String   @default("bronze")
  tierOrder   Int      @default(1) // 1=bronze, 2=silver, 3=gold, 4=platinum, 5=diamond

  // Sezona
  seasonId    String?
  season      Season?  @relation(fields: [seasonId], references: [id])

  isActive    Boolean  @default(false) // aktivna tek kad ima 5+ parova
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Kreator lige
  creatorId   String?
  creator     User?    @relation("LeagueCreator", fields: [creatorId], references: [id])

  teams     LeagueTeam[]
  matches   Match[]
  standings SeasonStanding[]
  matchups  LeagueMatchup[]
}

model LeagueTeam {
  id        String   @id @default(cuid())
  leagueId  String
  name      String?  // opcionalno ime tima
  createdAt DateTime @default(now())

  league         League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  players        LeagueTeamPlayer[]
  standings      SeasonStanding[]
  homeMatchups   LeagueMatchup[]    @relation("HomeTeam")
  awayMatchups   LeagueMatchup[]    @relation("AwayTeam")
}

// Round-robin raspored meceva u ligi
model LeagueMatchup {
  id          String    @id @default(cuid())
  leagueId    String
  round       Int       // broj kola (1, 2, 3...)
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime? // zakazano vrijeme
  matchId     String?   // linkiran odigrani mec
  status      String    @default("pending") // pending, scheduled, completed

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  locationId  String?

  league      League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam    LeagueTeam @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    LeagueTeam @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  match       Match?     @relation(fields: [matchId], references: [id])
  location    Location?  @relation(fields: [locationId], references: [id])

  @@unique([leagueId, round, homeTeamId, awayTeamId])
}

model LeagueTeamPlayer {
  id           String @id @default(cuid())
  leagueTeamId String
  userId       String

  leagueTeam LeagueTeam @relation(fields: [leagueTeamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueTeamId, userId])
}

// ============================================
// Season Standings - rang lista
// ============================================

model SeasonStanding {
  id             String   @id @default(cuid())
  seasonId       String
  leagueId       String

  // Moze biti tim ili pojedinac
  leagueTeamId   String?  // za parove
  userId         String?  // za pojedince (opcija rangiranja pojedinaca)

  // Statistika
  points           Int @default(0)
  matchesPlayed    Int @default(0)
  wins             Int @default(0)
  losses           Int @default(0)
  tiebreakLosses   Int @default(0) // porazi u tiebreaku (daju 1 bod)
  setsWon          Int @default(0)
  setsLost         Int @default(0)
  gamesWon         Int @default(0)
  gamesLost        Int @default(0)

  // Zavrsni rang na kraju sezone
  finalRank        Int?

  // Promocija/ispadanje
  promotedToLeagueId  String? // u koju ligu je promoviran
  relegatedToLeagueId String? // u koju ligu je ispao

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season     Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  league     League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam LeagueTeam? @relation(fields: [leagueTeamId], references: [id], onDelete: Cascade)
  user       User?       @relation("PlayerStanding", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, leagueId, leagueTeamId])
  @@unique([seasonId, leagueId, userId])
}

// ============================================
// Messaging
// ============================================

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  subject    String?
  content    String
  isRead     Boolean  @default(false)
  sentAt     DateTime @default(now())
  emailSent  Boolean  @default(false) // da li je poslano na email

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}
